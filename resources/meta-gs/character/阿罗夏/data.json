  "cons": {
    "1": {
      "name": "寒谷轰雷",
      "desc": [
        "队伍中附近的角色对敌人触发<span style=\"color:#FFACFFFF;\">雷元素相关反应</span>后，将为阿罗夏恢复15点元素能量，该效果每18秒至多触发一次。"
      ]
    },
    "2": {
      "name": "长嗥远讯",
      "desc": [
        "元素爆发<span style=\"color:#FFD780FF;\">守猎进踞</span>的持续时间延长6秒。\\n此外，<span style=\"color:#FFD780FF;\">图加林</span>每次攻击敌人前，还会为一名目标施加<span style=\"color:#FFD780FF;\">弋猎印记</span>；该效果不会激活已有的<span style=\"color:#FFD780FF;\">弋猎印记</span>。"
      ]
    },
    "3": {
      "name": "僚朋相唤",
      "desc": [
        "元素战技<span style=\"color:#FFD780FF;\">伏袭霆击</span>的技能等级提高3级。\\n至多提升至15级。"
      ]
    },
    "4": {
      "name": "衔取猎品",
      "desc": [
        "<span style=\"color:#FFD780FF;\">图加林</span>进行攻击时，还会为队伍中附近的生命值百分比最低的角色恢复生命值，回复量相当于阿罗夏攻击力的60%。"
      ]
    },
    "5": {
      "name": "莺啼止时",
      "desc": [
        "元素爆发<span style=\"color:#FFD780FF;\">守猎进踞</span>的技能等级提高3级。\\n至多提升至15级。"
      ]
    },
    "6": {
      "name": "复夺旌幡",
      "desc": [
        "激活<span style=\"color:#FFD780FF;\">弋猎印记</span>时获得的<span style=\"color:#FFD780FF;\">猎者之准</span>效果可以叠加。该效果至多叠加2层，叠加至2层时，还会使处于该效果影响下的当前场上角色的元素精通提升100点。"
      ]
    }
  },
  "passive": [
    {
      "name": "惊醒沉睡的林线",
      "desc": [
        "<span style=\"color:#FFD780FF;\">图加林</span>进行攻击时，还会为队伍中附近的当前场上角色恢复生命值，回复量相当于阿罗夏攻击力的120%。"
      ]
    },
    {
      "name": "告别冬麦与残叶",
      "desc": [
        "基于阿罗夏的元素充能效率，提升阿罗夏的元素战技与元素爆发造成的伤害：每1%元素充能效率都会使上述伤害提升0.35%，至多提升至70%。"
      ]
    },
    {
      "name": "星赴险域",
      "desc": [
        "处于<span style=\"color:#FFD780FF;\">极星辉域</span>中时，阿罗夏将会进入<span style=\"color:#FFD780FF;\">辉映·星超导</span>状态。\\n<span style=\"color:#FFD780FF;\">辉映·星超导</span>：激活<span style=\"color:#FFD780FF;\">弋猎印记</span>时获得的<span style=\"color:#FFD780FF;\">猎者之准</span>效果还会使角色处于场上时造成的星超导反应伤害提升20%。"
      ]
    },
    {
      "name": "树梢察伺",
      "desc": [
        "在小地图上显示周围的<span style=\"color:#FFD780FF;\">至冬区域特产</span>的位置。"
      ]
    }
