    },
    "4": {
      "name": "无需同阳光交易",
      "desc": "砂金•戏浪施放战技时，使我方全体造成的伤害无视敌方目标<nobr>$1[i]%</nobr>的防御力，持续<nobr>$2[i]</nobr>回合。"
    },
    "5": {
      "name": "掷身于满贯风暴",
      "desc": "终结技等级+2，最多不超过<nobr>15</nobr>级；普攻等级+1，最多不超过<nobr>10</nobr>级；欢愉技等级+1，最多不超过<nobr>15</nobr>级。"
    },
    "6": {
      "name": "将往日兑作一场狂飙",
      "desc": "砂金•戏浪造成的<u>欢愉伤害</u><u>增笑</u><nobr>$2[i]%</nobr>。砂金•戏浪施放<nobr>$1[i]</nobr>次欢愉技后，其后续施放的所有欢愉技均为【All in！敬炽烈一夏】，且在阿哈时刻外施放欢愉技【All in！敬炽烈一夏】造成额外伤害时不再消耗【热意】。"
    }
